{
  "manifest_version": 3,
  "name": "YouTube PiP",
  "version": "1.0.0",
  "description": "유튜브 영상을 PiP 모드로 띄웁니다",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "PiP 켜기/끄기 (Alt+P)" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+P", "mac": "Alt+P" }
    }
  }
}
